# HamR 服务端口契约 —— 单一真源
#
# 背景（proposed-fixes-v2 #08，P0）：同一个服务在不同 compose 里被写成了
# 不同的端口（hamr-jiabu-api 在 ali 栈是 3003、在 proxy 栈是 8082），
# 而 nginx 反代写的是 8082 —— 两处不一致，任一拓扑要么 proxy 找不到后端，
# 要么后端端口暴露错。线上 jiabu.hamr.store 的 /api/ 因此是 502。
#
# 规则：
#   1. 本文件是端口的**唯一真源**，ports.env 里的值即 canonical 值。
#   2. 各 docker-compose.yml 用 ${VAR:-canonical} 引用，
#      默认值与本文件一致 —— 不带 --env-file 启动也能得到正确拓扑。
#   3. nginx.conf 用同一批字面量，由 scripts/check-port-consistency.sh
#      校验三者一致，防止再次漂移。
#
# 使用：
#   docker compose --env-file services/ports.env -f services/proxy/docker-compose.yml up -d
#
# 校验（CI 会跑）：
#   ./scripts/check-port-consistency.sh

# ── 后端服务容器内监听端口 ──────────────────────────────
HAMR_ACCOUNT_API_PORT=3001
HAMR_APP_API_PORT=3002
HAMR_JIABU_API_PORT=8082
HAMR_DEMO_API_PORT=3004
HAMR_API_GATEWAY_PORT=8090

# ── 前端静态站点容器内监听端口 ──────────────────────────
HAMR_FRONTEND_PORT=80

# ── 监控组件 ───────────────────────────────────────────
HAMR_GRAFANA_PORT=3000
HAMR_PROMETHEUS_PORT=9090
HAMR_NODE_EXPORTER_PORT=9100

# ── 主机对外暴露端口（仅绑定 127.0.0.1，由 nginx 统一对外）──
HAMR_PROXY_HTTP_PORT=80
HAMR_PROXY_HTTPS_PORT=443
HAMR_GRAFANA_HOST_PORT=3000
